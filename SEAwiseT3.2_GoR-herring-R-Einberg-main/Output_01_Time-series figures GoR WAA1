rm(list = ls())

#Open data file GoR_WAA1_2024 (data = s)
#Year; waa - WAA age 1; R - age-1 abundance; SSB - spawning stock biomass; aug - mean August temperature; may - mean May temperature; sum - mean feeding period temperature; ws - winter severity; 
#e - E. affinis affinis; a - Acartia spp. ; ea - E. affinis affinis & Acartia spp.; N - copepod nauplii; E1 copepodite stages I-III; E2 copepodite stages IV-V; E3 adult copepods; e_N - mean log abundances in May; e2_N mean log abundances in August.
#0 indicates previous year values

#Figure 1
#Time-series (years 1961–2020) of the Gulf of Riga herring a) age-1 abundance  (age-1, 106 individuals) and spawning stock biomass (SSB, thousand tonnes) and b) weight at age (WWA, grams) of 1-year old fish (Ojaveer 1988 and references therein; Ojaveer et al. 2004; ICES 2023).
if(TRUE){
quartz(width = 8.6, height = 4.0)
par(mfrow = c(1, 2), tck = -0.02, mar = c(2.5,2.8,2,2.8), mgp = c(1.3,0.3,0))
plot(s$SSB ~ s$year, pch = 16, 
     col = 96, 
     axes = T,
     ylab = "SSB (x1000 tons)", xlab = "Year")

lines(s$SSB ~ s$year, col = 96)
axis(2, col = 1)
axis(1, at = c(1960, 1970, 1980, 1990, 2000, 2010), col = 1)
lines(c(1962, 1966),c(120, 120), col = 96)
lines(c(1962, 1966), c(110, 110))
points(1964, 120, pch = 16, col = 96)
points(1964, 110, pch = 16)
text(c(1968, 1968),c(120, 110), labels = c("SSB", "Age-1"), pos = 4)
par(new = T)
plot(s$R~ s$year, pch = 16, axes = F, ylab="", xlab = "", col = 1)
lines(s$R ~ s$year)
axis(4, col =1)
mtext(expression(paste("Age-1 (",10^6," individuals)")), side = 4, line = 1.5, cex = 1, col = 1)
mtext("a) Age-1, SSB", side = 3, adj = 0, line = 0, cex = 1) 


#growth 
plot(s$waa ~ s$year, pch = 16, 
     col = 1, 
     axes = T,
     ylab = "g", xlab="Year")

lines(s$waa ~ s$year, col = 1)
axis(2, col=1)
axis(1, at = c(1960, 1970, 1980, 1990, 2000, 2010), col=1)
mtext("b) Weight at age", side = 3, adj = 0, line = 0, cex = 1)
}
